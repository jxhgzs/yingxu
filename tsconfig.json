{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "skipLibCheck": true, "types": ["node"], "lib": ["ES2023", "DOM"]
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.vue", "test/**/*.ts", "scripts/**/*.ts"]
}
